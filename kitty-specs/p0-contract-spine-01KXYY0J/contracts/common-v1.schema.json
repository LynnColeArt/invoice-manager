{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invoice-manager.invalid/contracts/common/v1",
  "title": "Invoice Manager Common Values v1",
  "$defs": {
    "EntityId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "CurrencyCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "CanonicalInt64": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "description": "Canonical decimal spelling; runtime validation enforces signed 64-bit range."
    },
    "NonNegativeInt64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "Canonical non-negative decimal spelling; runtime validation enforces signed 64-bit range."
    },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "minor_units"],
      "properties": {
        "currency": { "$ref": "#/$defs/CurrencyCode" },
        "minor_units": { "$ref": "#/$defs/CanonicalInt64" }
      }
    },
    "LocalDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "UtcInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "RequestId": {
      "$ref": "#/$defs/EntityId"
    }
  }
}
