    "notApplicableCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale"
      ],
      "properties": {
        "status": {
          "const": "not_applicable"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        }
