    },
    "checkedSpec": {
      "allOf": [
        {
          "$ref": "#/$defs/checkedArtifact"
        },
        {
          "properties": {
            "path": {
              "const": "kitty-specs/p0-contract-spine-01KXYY0J/spec.md"
            }
          }
        }
      ]
    },
    "requirementRef": {
      "type": "string",
      "pattern": "^(?:FR|NFR|C)-[0-9]{3}$"
    },
    "acceptanceRef": {
      "type": "string",
      "pattern": "^(?:US-[1-4]/AS-[1-4]|SC-00[1-7])$"
    },
    "exampleMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "requirement_refs",
        "acceptance_refs"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "requirement_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirementRef"
          }
        },
        "acceptance_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
