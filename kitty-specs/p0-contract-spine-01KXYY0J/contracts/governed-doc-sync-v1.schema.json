    "mappingEventCatalog": {
      "allOf": [
        {
          "$ref": "#/$defs/exampleMapping"
        },
        {
          "properties": {
            "path": {
              "const": "kitty-specs/p0-contract-spine-01KXYY0J/contracts/event-catalog-v1.schema.json"
