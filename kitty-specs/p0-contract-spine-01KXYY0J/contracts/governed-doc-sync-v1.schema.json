        {
          "properties": {
            "path": {
              "const": "kitty-specs/p0-contract-spine-01KXYY0J/data-model.md"
            }
          }
        }
      ]
    },
    "checkedPlan": {
      "allOf": [
        {
          "$ref": "#/$defs/checkedArtifact"
        },
        {
          "properties": {
            "path": {
              "const": "kitty-specs/p0-contract-spine-01KXYY0J/plan.md"
            }
          }
        }
      ]
    },
    "checkedQuickstart": {
      "allOf": [
        {
          "$ref": "#/$defs/checkedArtifact"
        },
        {
          "properties": {
            "path": {
              "const": "kitty-specs/p0-contract-spine-01KXYY0J/quickstart.md"
            }
          }
        }
      ]
    },
    "checkedResearch": {
      "allOf": [
        {
          "$ref": "#/$defs/checkedArtifact"
        },
        {
          "properties": {
            "path": {
              "const": "kitty-specs/p0-contract-spine-01KXYY0J/research.md"
            }
          }
        }
      ]
    },
    "checkedEvidenceLog": {
      "allOf": [
        {
          "$ref": "#/$defs/checkedArtifact"
        },
        {
          "properties": {
            "path": {
              "const": "kitty-specs/p0-contract-spine-01KXYY0J/research/evidence-log.csv"
