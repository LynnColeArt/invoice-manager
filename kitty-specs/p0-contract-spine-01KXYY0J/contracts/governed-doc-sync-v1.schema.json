          }
        }
      ]
    },
    "checkedModuleContribution": {
      "allOf": [
        {
          "$ref": "#/$defs/checkedArtifact"
        },
        {
          "properties": {
            "path": {
              "const": "kitty-specs/p0-contract-spine-01KXYY0J/contracts/module-contribution-v1.schema.json"
            }
          }
        }
      ]
    },
    "checkedP0Manifest": {
      "allOf": [
        {
          "$ref": "#/$defs/checkedArtifact"
        },
        {
          "properties": {
            "path": {
              "const": "kitty-specs/p0-contract-spine-01KXYY0J/contracts/p0-contract-manifest.json"
            }
          }
        }
      ]
    },
    "checkedDataModel": {
      "allOf": [
        {
          "$ref": "#/$defs/checkedArtifact"
