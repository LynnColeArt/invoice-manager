              "const": "kitty-specs/p0-contract-spine-01KXYY0J/contracts/event-envelope-v1.schema.json"
            }
          }
        }
      ]
    },
    "checkedSyncSchema": {
      "allOf": [
        {
          "$ref": "#/$defs/checkedArtifact"
        },
        {
          "properties": {
            "path": {
              "const": "kitty-specs/p0-contract-spine-01KXYY0J/contracts/governed-doc-sync-v1.schema.json"
            }
          }
        }
      ]
    },
    "checkedMigrationManifest": {
      "allOf": [
        {
          "$ref": "#/$defs/checkedArtifact"
        },
        {
          "properties": {
            "path": {
              "const": "kitty-specs/p0-contract-spine-01KXYY0J/contracts/migration-manifest-v1.schema.json"
