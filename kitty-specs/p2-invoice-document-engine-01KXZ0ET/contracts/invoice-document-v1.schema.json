{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invoice-manager.invalid/contracts/p2/invoice-document/v1",
  "title": "P2 Invoice Document Draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "language", "paper_size", "issue_date", "due_date", "currency", "issuer", "recipient", "billing_market", "remittance_decision", "logo_mode", "lines", "template"],
  "properties": {
    "schema_version": { "const": "0.1.0-draft.1" },
    "document_id": { "$ref": "#/$defs/EntityId" },
    "document_number": { "type": ["string", "null"], "maxLength": 64 },
    "language": { "const": "en" },
    "paper_size": { "enum": ["letter", "a4"] },
    "issue_date": { "$ref": "#/$defs/LocalDate" },
    "due_date": { "$ref": "#/$defs/LocalDate" },
    "currency": { "enum": ["USD", "EUR"] },
    "issuer": { "$ref": "#/$defs/PartySnapshot" },
    "recipient": { "$ref": "#/$defs/PartySnapshot" },
    "billing_market": { "enum": ["domestic", "europe", "other"] },
    "remittance_decision": { "enum": ["omitted", "included"] },
    "remittance": { "$ref": "#/$defs/Remittance" },
    "logo_mode": { "enum": ["off", "on"] },
    "logo": { "$ref": "#/$defs/Logo" },
    "lines": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/Line" } },
    "notes": { "type": "string", "maxLength": 8192 },
    "template": { "$ref": "#/$defs/TemplateRef" }
  },
  "allOf": [
    {
      "if": { "properties": { "remittance_decision": { "const": "omitted" } }, "required": ["remittance_decision"] },
      "then": { "not": { "required": ["remittance"] } },
      "else": { "required": ["remittance"] }
    },
    {
      "if": { "properties": { "logo_mode": { "const": "off" } }, "required": ["logo_mode"] },
      "then": { "not": { "required": ["logo"] } },
      "else": { "required": ["logo"] }
    }
  ],
  "$defs": {
    "EntityId": { "$ref": "https://invoice-manager.invalid/contracts/common/v1/schema.json#/$defs/EntityId" },
    "CanonicalInt64": { "$ref": "https://invoice-manager.invalid/contracts/common/v1/schema.json#/$defs/CanonicalInt64" },
    "CanonicalQuantity": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$", "not": { "const": "0" } },
    "LocalDate": { "$ref": "https://invoice-manager.invalid/contracts/common/v1/schema.json#/$defs/LocalDate" },
    "Money": { "$ref": "https://invoice-manager.invalid/contracts/common/v1/schema.json#/$defs/Money" },
    "PartySnapshot": {
      "type": "object", "additionalProperties": false, "required": ["display_name", "legal_name", "address_lines"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "legal_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "address_lines": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "tax_labels": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 256 } }
      }
    },
    "Remittance": {
      "type": "object", "additionalProperties": false, "required": ["account_holder", "bank_name", "iban", "bic", "currency"],
      "properties": {
        "account_holder": { "type": "string", "minLength": 1, "maxLength": 256 },
        "bank_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "iban": { "type": "string", "pattern": "^[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}$" },
        "bic": { "type": "string", "pattern": "^[A-Z0-9]{8}([A-Z0-9]{3})?$" },
        "currency": { "enum": ["USD", "EUR"] }
      }
    },
    "Logo": {
      "type": "object", "additionalProperties": false, "required": ["asset_id", "media_type", "byte_length", "sha256_digest"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/EntityId" },
        "media_type": { "const": "image/png" },
        "byte_length": { "type": "integer", "minimum": 1, "maximum": 2097152 },
        "sha256_digest": { "$ref": "https://invoice-manager.invalid/contracts/common/v1/schema.json#/$defs/Sha256Digest" }
      }
    },
    "Tax": {
      "type": "object", "additionalProperties": false, "required": ["treatment", "label"],
      "properties": {
        "treatment": { "enum": ["standard", "zero_rated", "exempt", "reverse_charge", "out_of_scope"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "rate_ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "note": { "type": "string", "maxLength": 512 }
      }
    },
    "Line": {
      "type": "object", "additionalProperties": false, "required": ["id", "display_order", "description", "pricing", "tax"],
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "display_order": { "type": "integer", "minimum": 0 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "pricing": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind", "amount"], "properties": { "kind": { "const": "fixed" }, "amount": { "$ref": "#/$defs/Money" } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "quantity", "unit_label", "unit_rate"], "properties": { "kind": { "const": "quantity_rate" }, "quantity": { "$ref": "#/$defs/CanonicalQuantity" }, "unit_label": { "type": "string", "minLength": 1, "maxLength": 64 }, "unit_rate": { "$ref": "#/$defs/Money" } } }
          ]
        },
        "tax": { "$ref": "#/$defs/Tax" }
      }
    },
    "TemplateRef": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "const": "invoice-default" }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" } }
    }
  }
}
