{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invoice-manager.invalid/contracts/p3/backup-manifest/v1",
  "title": "P3 Backup Manifest v1 Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "backup_id", "created_at", "application", "contracts", "migrations", "entries", "complete"],
  "properties": {
    "format_version": { "const": "0.1.0-draft.1" },
    "backup_id": { "$ref": "#/$defs/EntityId" },
    "created_at": { "$ref": "#/$defs/UtcInstant" },
    "application": {
      "type": "object", "additionalProperties": false, "required": ["version", "source_commit"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "contracts": {
      "type": "object", "additionalProperties": false, "required": ["p0", "p3"],
      "properties": { "p0": { "type": "string" }, "p3": { "type": "string" } }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "owner", "sha256_digest"],
        "properties": {
          "id": { "$ref": "#/$defs/EntityId" },
          "owner": { "type": "string", "pattern": "^p[0-9]+$" },
          "sha256_digest": { "$ref": "#/$defs/Digest" }
        }
      }
    },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "type", "mode", "byte_length", "sha256_digest"],
        "properties": {
          "path": { "type": "string", "pattern": "^[^/](?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]*$" },
          "type": { "const": "regular_file" },
          "mode": { "enum": ["0600", "0640"] },
          "byte_length": { "type": "integer", "minimum": 0 },
          "sha256_digest": { "$ref": "#/$defs/Digest" }
        }
      }
    },
    "checkpoint_digest": { "$ref": "#/$defs/Digest" },
    "complete": { "const": true }
  },
  "$defs": {
    "EntityId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "UtcInstant": { "type": "string", "format": "date-time" },
    "Digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
